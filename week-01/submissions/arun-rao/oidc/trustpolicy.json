{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Principal": {
                "Federated": "arn:aws:iam::268112656247:oidc-provider/token.actions.githubusercontent.com"
            },
            "Action": "sts:AssumeRoleWithWebIdentity",
            "Condition": {
                "StringEquals": {
                    "token.actions.githubusercontent.com:": "sts.amazonaws.com"
                },
                "StringLike": {
                    "token.actions.githubusercontent.com:": [
                        "repo:Nurarao/aws-oidc-challenge:*"
                    ]
                }
            }
        }
    ]
}
